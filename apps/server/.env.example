# Copy to apps/server/.env (gitignored) and fill in. Loaded automatically by
# server.ts via node:process's loadEnvFile() — no separate dotenv package.

# Set to "gemini" to use real Gemini/Imagen for text+image instead of the local
# mflux/mlx-lm adapters. Leave unset (or "local") for local-only dev.
OSAI_PROVIDER=gemini

# --- Credentials for OSAI_PROVIDER=gemini: pick ONE of the two blocks below ---

# A) Vertex AI (recommended — this is the hackathon's Google Cloud surface).
#    Auth is Application Default Credentials: run once locally
#      gcloud auth application-default login
#    On Cloud Run the attached service account is used automatically.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# B) AI Studio (quick local dev, no GCP project). Get a key at
#    https://aistudio.google.com/apikey — then unset the GOOGLE_* vars above.
# GEMINI_API_KEY=

# Optional model overrides — defaults are gemini-2.5-flash / imagen-4.0-generate-001.
# GEMINI_TEXT_MODEL=
# GEMINI_IMAGE_MODEL=
